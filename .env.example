# === AI Provider Keys (for internal gateway at /api/ai-gateway) ===
# At least one key is required for the internal gateway to work.
# Fallback order: Gemini → Groq → NVIDIA → OpenRouter
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# === External AI Gateway (optional — overrides internal gateway) ===
# HTTPS URL of the Worker (no trailing slash)
# AI_ROUTER_URL=https://nexus-ai-gateway.YOUR_SUBDOMAIN.workers.dev
# Shared secret — server-side ONLY (never NEXT_PUBLIC_)
# AI_ROUTER_TOKEN=

# === Direct LLM (only if both AI_ROUTER_URL and provider keys are unset) ===
# LLM_PROVIDER=openai
# LLM_API_KEY=

# === Storage ===
# STORAGE_PROVIDER=file|memory

# === Tools (off by default) ===
# TOOL_ALLOW_WEB=true
# TOOL_ALLOW_URL_READ=true
# TOOL_ALLOW_FILE_WRITE=true
