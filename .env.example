# === Secure AI Gateway (Cloudflare Worker) — production ===
# HTTPS URL of the Worker (no trailing slash)
AI_ROUTER_URL=https://nexus-ai-gateway.YOUR_SUBDOMAIN.workers.dev
# Shared secret — server-side ONLY (never NEXT_PUBLIC_)
AI_ROUTER_TOKEN=

# Local Termux router (optional during development)
# AI_ROUTER_URL=http://127.0.0.1:3000
# AI_ROUTER_SECRET=   # alias for AI_ROUTER_TOKEN on local routers

# === Direct LLM (only if AI_ROUTER_URL is unset) ===
# LLM_PROVIDER=openai
# LLM_API_KEY=

# === Storage ===
# STORAGE_PROVIDER=file|memory

# === Tools (off by default) ===
# TOOL_ALLOW_WEB=true
# TOOL_ALLOW_URL_READ=true
# TOOL_ALLOW_FILE_WRITE=true
